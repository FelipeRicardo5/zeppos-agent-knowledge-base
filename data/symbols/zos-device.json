      "signature": "function getDataDiskInfo(): Result",
      "shapes": [
        {
          "name": "SuccessResult",
          "props": [
            {
              "name": "isSuccess",
              "type": "true",
              "description": "The query succeeded",
              "apiLevel": 5
            },
            {
              "name": "total",
              "type": "number",
              "description": "Total data partition capacity in bytes",
              "apiLevel": 5
            },
            {
              "name": "free",
              "type": "number",
              "description": "Available data partition capacity in bytes",
              "apiLevel": 5
            },
            {
              "name": "used",
              "type": "number",
              "description": "Used data partition capacity in bytes",
              "apiLevel": 5
            }
          ]
        },
        {
          "name": "FailResult",
          "props": [
            {
              "name": "isSuccess",
              "type": "false",
              "description": "The query failed; capacity fields are not included",
              "apiLevel": 5
            }
          ]
        }
      ],
