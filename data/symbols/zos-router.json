      "type": "function",
      "description": "Register a timer to launch the Mini Program at a given time.",
      "minApiLevel": 2,
      "signature": "function setLaunchAppTimeout(option: Option): Result",
      "shapes": [
        {
          "name": "Option",
          "props": [
            {
              "name": "appId",
              "type": "number",
              "description": "Mini Program ID",
              "apiLevel": 2
            },
            {
              "name": "url",
              "type": "string",
              "description": "path",
              "apiLevel": 2
            },
            {
              "name": "utc",
              "type": "number",
              "description": "utc timestamp(milliseconds)，the priority is higher than delay, and when set at the same time as the delay field, only the utc field takes effect",
              "apiLevel": 2
            },
            {
              "name": "delay",
              "type": "number",
              "default": "0",
              "description": "The time, in milliseconds that the timer should wait before the Mini Program is waked.",
              "apiLevel": 3
            },
            {
              "name": "params",
              "type": "string&#124;object",
              "description": "The argument passed to the app.js lifecycle onCreate supports either a string or a standard JSON object. If a standard JSON object is passed, the method internally converts it to a string",
              "apiLevel": 2
            }
          ]
        }
      ],
