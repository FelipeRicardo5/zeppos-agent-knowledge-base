{
  "configVersion": "v3",
  "app": {
    "appId": 1022389,
    "appName": "simple-keyboard",
    "appType": "app",
    "version": { "code": 1, "name": "1.0.0" },
    "icon": "icon.png",
    "vender": "zepp",
    "description": "simple keyboard sample"
  },
  "permissions": ["device:os.input.method", "data:os.device.info"],
  "runtime": { "apiVersion": { "compatible": "4.2.0", "target": "4.2.0" } },
  "targets": {
    "gt.r": {
      "module": {
        "page": { "pages": ["page/index", "page/update"] },
        "setting": { "path": "setting/index" },
        "app-service": { "services": ["app-service/index", "app-service/never-written"] }
      },
      "platforms": [{ "st": "r", "sr": "w480" }]
    },
    "gt.s": {
      "module": { "page": { "pages": ["page/index"] } },
      "platforms": [{ "st": "s" }]
    }
  },
  "i18n": { "en-US": { "appName": "Simple Keyboard" } },
  "defaultLanguage": "en-US"
}
